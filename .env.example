# Copy this file to .env and fill in your values. .env is gitignored.

# Home desk. The shipped broker adapter is ICICI Direct's Breeze API (India,
# free for its clients; register an app once at https://api.icicidirect.com/apiuser/home).
# Another broker: see README, "Adapting to your broker". No broker yet: leave
# these two empty; the desk still boots and every other tab runs.
BREEZE_API_KEY=your_api_key_here
BREEZE_API_SECRET=your_api_secret_here
# The daily session token is NOT stored here. The desk asks for it in the
# terminal each morning and caches it for the day (session_token_*.txt).

# Optional data feed for the US pages (Financial Modeling Prep, any plan).
# Leave empty to run the US watch grid on Yahoo's free quotes only.
FMP_API_KEY=

# SEC EDGAR asks for a contact address in the User-Agent of every request.
EDGAR_CONTACT=your-email@example.com

# Where the dated markdown reports go. Empty = ./output inside this folder.
# Point it at a folder inside your Obsidian vault to read them there.
VAULT_OUTPUT_DIR=

# Port for the live desk (default 8765).
DESK_PORT=8765
